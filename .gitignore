# Ignore everything by default. This repository should only track:
# - prototype/
# - docs/
# - AGENTS.md
# - CLAUDE.md
*

# Keep Git metadata files visible locally.
!.gitignore

# Tracked project scope.
!AGENTS.md
!CLAUDE.md
!docs/
!docs/**
!prototype/
!prototype/**

# Common generated/local files inside allowed folders.
**/.DS_Store
**/Icon?

# Explicitly keep large/local material outside Git.
old_build/
Build/
VFXmp4/
VFXwebp/
画像素材/
資料/
*.gsheet
*.numbers
*.psd
*.ai
*.tmp

# VFX LAB の撮影結果（再生成できる。大きいので入れない）
prototype/tools/vfx_preview/shots/
prototype/tools/vfx_preview/review/
prototype/tools/vfx_preview/capture_frames/
prototype/tools/action_banner_mock.jpg

# webp から切り出した比較用の参照画像（tools/vfx_capture/extract_refs.py で作り直せる。41MB）。基準の reference.json は残す。
prototype/tools/vfx_capture/refs/**/*.png

# 周回・固定盤面の出力（大きく、作り直せる）。main には入れない（2026-10-18）
prototype/tools/balance_sim/out/
prototype/tools/balance_sim/out_*/
